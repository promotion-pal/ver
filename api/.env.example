# ─────────────────────────────────────────────────────────────
#  ver api — cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=ver
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ver_db

# Имя контейнера БД в prod (= container_name у ver_db).
POSTGRES_HOST=ver_db

# Временный пароль доступа к хабу и API (проверяется на сервере, из ENV попадает в config).
# Обязателен: без него API не стартует. Смена пароля отзывает все выданные сессии.
ACCESS_PASSWORD=change-me
# Срок жизни сессии после входа (по умолчанию 24h).
# ACCESS_SESSION_TTL=24h

API_TZ=Asia/Vladivostok
